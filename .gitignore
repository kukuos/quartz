.DS_Store
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
.replit
replit.nix
.quartz/
quartz/cli/tui/dist/
.turbo/

# ---- 部署产物（服务器端生成，不入库） ----
logs/
backups/
.deploy.lock
*.building/
*.prev/

# ---- 敏感文件兜底 ----
# publish.ps1 已经会扫描并拦截，这里是 Git 层的最后一道防线：
# 即使这些文件被放进 content/，也不会被提交。
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.ppk
*.keystore
*.jks
*.kdbx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
.htpasswd
.netrc
# 只忽略内容目录里的 .npmrc；项目根的 .npmrc 是 Quartz 构建配置，必须保留
content/**/.npmrc
credentials
credentials.*
secrets.yml
secrets.yaml
secrets.json

# ---- 视频不入库 ----
# 与 Obsidian Vault 的 .gitignore 保持一致：视频体积大，进仓库会持续膨胀，
# GitHub 单文件上限 100MB。视频由 publish.ps1 通过 SSH 直传服务器媒体目录，
# 再由 Nginx 单独映射，网站上照常播放。
content/**/*.mp4
content/**/*.webm
content/**/*.mov
content/**/*.avi
content/**/*.mkv
content/**/*.m4v
content/**/*.flv
content/**/*.wmv
content/**/*.mpg
content/**/*.mpeg
