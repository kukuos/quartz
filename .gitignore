id_ecdsa
id_ecdsa.*
.htpasswd
.netrc
# 只忽略内容目录里的 .npmrc；项目根的 .npmrc 是 Quartz 构建配置，必须保留
content/**/.npmrc
credentials
credentials.*
secrets.yml
secrets.yaml
secrets.json
